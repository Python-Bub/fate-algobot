# =========================================================================
# FATE_AlgoBot HFT module — copy to .env (or just inherit from the root /.env)
# All keys are read by both algorithms unless noted.
# =========================================================================

# ---- BROKER (Alpaca paper by default — same keys used by the Python side) ----
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_BASE=https://data.alpaca.markets
# IEX (free) or SIP (paid). For Polygon, leave these blank and set POLYGON_* below.
ALPACA_DATA_STREAM=wss://stream.data.alpaca.markets/v2/iex

# ---- POLYGON (premium L1/L2 + news; recommended for HFT) ----
POLYGON_API_KEY=
POLYGON_STOCKS_STREAM=wss://socket.polygon.io/stocks
POLYGON_NEWS_STREAM=wss://socket.polygon.io/stocks
# Set true to subscribe to NASDAQ TotalView L2 ("XL.*") — requires the Polygon L2 add-on.
POLYGON_USE_LEVEL2=false

# ---- BENZINGA (news; recommended for earnings algorithm) ----
BENZINGA_API_KEY=
BENZINGA_NEWS_STREAM=wss://api.benzinga.com/api/v1/news/stream

# ---- COMMON SAFETY ----
HFT_DRY_RUN=true                      # true = log orders only, never POST to broker
HFT_SIM_BROKER=true                   # dry-run: NBBO-cross fill model (not instant fake fills)
HFT_SIM_BROKER_LEGACY=false           # true = old dry-run (always filled @ $100)
HFT_MAX_QUOTE_AGE_MS=2500             # reject stale quotes before OBI/MR fire
HFT_MAX_MID_SHOCK_BPS=500             # reject bad-feed price shocks
HFT_SKIP_QUOTE_HEALTH=false           # true = disable quote-health (debug only)
HFT_GLOBAL_KILL=false                 # flip true to lock the entire process immediately
HFT_MAX_ORDERS_PER_MIN=30
HFT_PER_TICKER_COOLDOWN_MS=60000      # lockdown window after a fill

# ---- EARNINGS ALGO ----
EARN_TICKER_WHITELIST=AAPL,MSFT,NVDA,AMZN,META,GOOGL,TSLA,AMD,AVGO,COST,LLY,JPM,V,MA,SPY,QQQ
EARN_SURPRISE_PCT_TRIGGER=5.0         # >|5%| EPS or Revenue surprise → fire
EARN_NOTIONAL_USD=2500                # per trade
EARN_LIMIT_TICK_OFFSET=2              # ticks above/below NBBO for IOC limit
EARN_BUDGET_LATENCY_MS=100            # circuit-breaker: abort if ingestion→fire > 100ms
EARN_VWAP_WINDOW_MS=10000             # 10-second VWAP volatility filter
EARN_FILL_DEADLINE_MS=400             # cancel-and-flatten if not filled in 400ms

# ---- OBI + TAPE ALGO ----
OBI_TICKER_WHITELIST=SPY,QQQ,AAPL,MSFT,NVDA,AMD,TSLA,META,AMZN
OBI_TRIGGER_LONG=0.75
OBI_TRIGGER_SHORT=-0.75
TAPE_VELOCITY_WINDOW_MS=100
TAPE_BASELINE_WINDOW_MS=5000
TAPE_VELOCITY_MULTIPLIER=5.0
OBI_NOTIONAL_USD=1000
OBI_MICRO_STOP_TICKS=3                # flatten if NBBO moves 3 ticks against entry
OBI_BUDGET_LATENCY_MS=10              # processing budget per L2 update
TICK_SIZE=0.01
