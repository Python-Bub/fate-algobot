# --- last-wins 2026-09-24: the book was not trading, it was filtered out ---
# 12 cent take-profit is ~6 bps on a $200 name. The real spread is often wider,
# so the edge gate skipped every liquid ticker. Judge the scalp in bps.
# Confidence 0.50 sat above OBI_TRIGGER_LONG=0.22, so a trigger that already
# fired was thrown away (that is the ~2/min stuck book). OOS cook skill is
# ~53% and the high-conviction cut lagged just holding — 0.64 was trained
# too tight for live. Pace-fill stays off. 4/sec lets the 200/min cap bind.
# REST walks 24 names per poll so the rotation is not a 75s stale loop.
HFT_TARGET_EDGE_BPS=8
HFT_MAX_ORDERS_PER_SEC=4
# 0.20 still sat above a 0.10 book. The trigger and the floor have to match
# or the fire is deleted after it already qualified.
HFT_MIN_CONFIDENCE=0.10
OBI_TRIGGER_LONG=0.10
HFT_MICRO_MIN_UP_PROB=0.53
# Regular hours: a dip plus the book is enough. Extended still wants a candle.
HFT_MR_REQUIRE_PATTERN=false
MIN_MODEL_CONFIDENCE=0.54
FORTRESS_FILL_MIN_CONF=0.54
FORTRESS_MIN_CONVICTION=0.12
HFT_REST_POLL_SLICE=24
