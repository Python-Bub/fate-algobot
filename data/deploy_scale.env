HFT_PACE_FILL=false
MAX_GROSS_LEVERAGE=1.0
# A red Friday was still holding losers until -0.8% and the 2.8% hard stop.
# Cut at -0.3% once the session is red. Through the daily-loss line, every
# loser goes. Winners stay. HFT inventory that is actually red flattens too.
FORTRESS_RED_DAY_SESSION_PCT=0.005
FORTRESS_RED_DAY_CUT_PCT=0.003
FORTRESS_RED_DAY_FLATTEN_PCT=0.008
HFT_HALT_FLATTEN_ADVERSE=0.0005
# Same name was cancelled and bought again every few seconds. One entry per
# minute. Do not sweep a live entry off the book at 8s so the signal re-fires.
HFT_REPEAT_ORDER_MS=60000
HFT_ENTRY_MISS_COOLDOWN_MS=60000
HFT_STALE_ORDER_MAX_AGE_MS=900000
# Cash-only tickets and an 8% HFT inventory cap left the Reg T and day BP idle.
# Overnight can use Reg T (2×). Same-day HFT can hold 1.25× equity and flattens.
# A 1.5% hard stop caps a name the red-day cut has not already sold.
# A red day still zeros the HFT budget so we do not add while the book is down.
HFT_MAX_ORDER_NOTIONAL=0
HFT_MAX_HFT_INVENTORY_FRAC=1.25
